{
  "name": "money-pit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:signed-in": "playwright test --project=signed-in",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:ping": "bun scripts/db-ping.ts",
    "auth:generate": "auth generate --config scripts/auth-cli.config.ts --output src/db/schema/auth.ts -y && prettier --write src/db/schema/auth.ts",
    "auth:check": "bun scripts/auth-session-check.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then bun run db:migrate; fi && next build"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.6",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.2.12",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.2.4",
    "react-querybuilder": "^8.21.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "auth": "1.7.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
